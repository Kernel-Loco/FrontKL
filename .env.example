# Dónde escucha FastAPI, visto desde el servidor de Next. El navegador nunca la usa:
# llama a /api/v1 en el propio portal y Next lo reenvía (next.config.ts).
API_INTERNAL_URL=http://127.0.0.1:8000

# Opcional, solo para desarrollo: minutos de inactividad antes de cerrar la sesión.
# Por defecto 15 (OWASP ASVS / ISO 27001), igual que la sesión en el servidor.
# NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=2
