# URL base de la API FastAPI (todavía no se usa: los servicios devuelven datos mock).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Opcional, solo para desarrollo: minutos de inactividad antes de cerrar la sesión.
# Por defecto 15 (OWASP ASVS / ISO 27001). Útil bajarlo a 2 para probar el aviso.
# NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=2
